+/** Octave slips that last longer than the neighbourhood median can see. Consecutive frames 10 ms
+ * apart cannot differ by an octave, so each octave jump between neighbours is cut into runs; a run
+ * whose median sits more than `farOctaves` from the clip's own voiced median is moved by one octave
+ * if that brings it within `nearOctaves` of the median. A creaky phrase end or a doubled stretch of
+ * several frames is corrected; a run that is merely high or low in the speaker's range is not. */
+function correctOctaveRuns(f0s: (number | null)[], jump = 0.6, farOctaves = 0.6, nearOctaves = 0.5): (number | null)[] {
+  const voiced = f0s.filter((v): v is number => v !== null);
+  if (voiced.length < 8) return f0s;
+  const clipMedian = median(voiced);
+  const out = [...f0s];
+  let i = 0;
+  while (i < out.length) {
+    if (out[i] === null) {
+      i++;
+      continue;
+    }
+    let from = i;
+    for (let k = i + 1; k <= out.length; k++) {
+      const cur = k < out.length ? out[k] : null;
+      if (cur !== null && cur !== undefined && Math.abs(Math.log2(cur / out[k - 1]!)) <= jump) continue;
+      // run [from, k - 1]
+      const runMedian = median(out.slice(from, k) as number[]);
+      const off = Math.log2(runMedian / clipMedian);
+      if (Math.abs(off) > farOctaves) {
+        const shift = off > 0 ? -1 : 1;
+        if (Math.abs(off + shift) <= nearOctaves) for (let q = from; q < k; q++) out[q] = out[q]! * 2 ** shift;
+      }
+      if (cur === null || cur === undefined) {
+        i = k;
+        break;
+      }
+      from = k;
+    }
+  }
+  return out;
+}
